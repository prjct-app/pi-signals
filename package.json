{
  "name": "@prjct.app/pi-signals",
  "version": "0.1.2",
  "description": "Local failure signals, daily agent-owned triage and verified repair candidates for Pi.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "signals",
    "triage",
    "quality"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist",
    "bin"
  ],
  "dependencies": {
    "@prjct.app/pi-secrets": "^0.2.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.4",
    "@earendil-works/pi-coding-agent": ">=1.0.4",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import ./tests/isolate.mjs --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build"
  },
  "bin": {
    "pi-signals": "bin/cli.mjs"
  }
}
